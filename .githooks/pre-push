#!/usr/bin/env bash
# pre-push — corre validate.py antes de que nada salga del disco. githooks(5): si
# sale distinto de cero, el push se aborta.
#
# No sustituye al CI: lo adelanta. La diferencia práctica es que un guardián roto
# se ve en 20 segundos acá en vez de en 5 minutos allá, y no ocupa un runner.
#
# Degradación deliberada: si falta python3 o validate.py, no bloquea. Un hook que
# rompe el flujo por su propio entorno se desactiva y deja de proteger.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 0
# Git exporta GIT_DIR a los hooks. Lo hereda todo lo que corre validate.py, y un
# `git init` en una carpeta temporal (tests/pipeline/test_actualizar.py) re-inicializaba
# el repo REAL como bare: desde un worktree, cada push dejaba la carpeta principal
# en `core.bare = true` (19 oct 2026, dos veces). Los guardianes trabajan sobre la
# carpeta en la que están, no sobre el repo que les llega por el entorno.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX
[ -f validate.py ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

_frenar(){  # $1 = qué falló; $2 = el detalle. Por ARGUMENTO, no por pipe: dentro de
            # un pipe corre en un subshell y su `exit 1` no detiene el hook (pasó).
  printf '\033[31m✗ %s — el push se detuvo acá, no en CI\033[0m\n' "$1" >&2
  printf '%s\n' "$2" | sed 's/^/    /' >&2
  printf '  (si es a propósito: git push --no-verify)\n' >&2
  exit 1
}

# EL CANDADO (unificado el 19 oct 2026). Vivía aparte en .git/hooks/pre-push, que
# git NO ejecuta desde que el repo usa core.hooksPath: corría solo validate.py y
# los otros tres pasos estaban apagados sin que nadie lo viera. Ahora es este archivo,
# versionado, para todos los clones. Los mismos chequeos que el CI, en ~1 min.

# 1. Nada a medias: un bump o un arreglo sin commitear sale distinto de lo probado.
_sucio=$(git status --porcelain --untracked-files=no)
[ -z "$_sucio" ] || _frenar 'hay cambios sin commitear (¿bump a medias?)' "$_sucio"

# 1·bis. La frontera código/datos, la MISMA regla que el CI (scripts/frontera.sh).
# Contra origin/main: es lo que verá el PR. Una rama de datos con una línea de
# validate.py se frena acá en un segundo, no tras 20 min de CI (#1338, 28 oct).
# Un push a `main` o a `datos` no es un PR: no aplica.
_rama=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ -f scripts/frontera.sh ] && [ "$_rama" != main ] && [ "$_rama" != datos ] \
   && git rev-parse -q --verify origin/main >/dev/null; then
  salida=$(bash scripts/frontera.sh "$(git merge-base origin/main HEAD)" HEAD 2>&1) \
    || _frenar 'mezcla código y datos: van en dos PR (primero el de código)' \
         "$(printf '%s\n' "$salida" | sed -n '/^Código:/,$p' | grep -v '::error::')"
fi

# 2. validate.py
salida=$(python3 validate.py 2>&1) || true
if printf '%s' "$salida" | grep -q "PUSH BLOQUEADO"; then
  _frenar 'validate.py no pasa' "$(printf '%s\n' "$salida" | grep "✗")"
fi

if command -v node >/dev/null 2>&1; then
  # 3. la forma de los 35 festivales
  salida=$(node scripts/validate-festivals.js 2>&1) || _frenar 'validate-festivals no pasa' "$(printf '%s\n' "$salida" | grep "✗" | head -15)"
  # 4. los tests unitarios de dominio
  salida=$(node --test tests/unit/*.test.js 2>&1) || _frenar 'tests unitarios' "$(printf '%s\n' "$salida" | grep -E "^not ok|^# fail" | head -15)"
fi
printf '\033[32m✓ candado: validate.py, validate-festivals y unit en verde\033[0m\n' >&2
exit 0
