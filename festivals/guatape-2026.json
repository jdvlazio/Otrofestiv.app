18:00","day_order":1,"venue":"Parque Principal - Guatapé","sala":"Domo","has_qa":false,"_src":{"url":"https://www.instagram.com/p/Def6fhKDSQy/","date":"2026-10-14","lamina":3},"is_cortos":true,"film_list":[{"title":"Hasta que amanezca","director":"Sebastián Rosas Santamaría","country":"Colombia","flags":"🇨🇴","poster":"/assets/bhff-2026/hasta-que-amanezca.jpg","year":2026,"posterSource":"oficial","duration":"5 min","work_id":"w_ZR5KC2MVSDVP"},{"title":"El Umbral","country":"Colombia","flags":"🇨🇴","work_id":"w_8GJ7ADWB5DJ5"}],"id":"f_0a04a4a478","is_free":true},{"title":"Horizonte","type":"film","section":"🦋 Rumbo a los Macondo","director":"César Augusto Acevedo","year":2025,"country":"Chile, Colombia, France, Germany, Luxembourg","flags":"🇨🇱🇨🇴🇫🇷🇩🇪🇱🇺","duration":"125 min","genre":"Drama","day":"2026-10-22","time":"18:00","day_order":1,"venue":"Muelle Corona - Guatapé","has_qa":false,"synopsis":"Dos fantasmas, una madre y su hijo, buscan al padre desaparecido del muchacho en un viaje físico y espiritual por un mundo arrasado por la guerra. Basilio, que en vida fue un criminal, debe revivir sus actos con su madre como testigo. Solo a través de un gran sacrificio encontrarán la redención que buscan.","synopsis_lang":"es","poster":"/assets/guatape-2026/horizonte.jpg","posterSource":"tmdb","_src":{"url":"https://www.instagram.com/p/Def6fhKDSQy/","date":"2026-10-14","lamina":3},"lbSlug":"horizon-2024-4","tmdb_id":1265716,"synopsis_en":"It is about two ghosts, a mother and son, search for the boy’s missing father on a journey, both physical and spiritual, through a world ravaged by war. Only through great sacrifice will they mend the fragile bonds that bind them and perhaps find redemption.","title_en":"Horizon","id":"f_07965746a3","is_free":true,"work_id":"w_8GJ7B5KCEQ78"},{"title":"La Gran Hazaña","type":"film","section":"🎞️ Muestra de Cine Colombiano","director":"Luber Yesid Zúñiga Ordóñez","year":2025,"country":"Colombia","flags":"🇨🇴","duration":"14 min","genre":"Aventura","day":"2026-10-22","time":"18:00","day_order":1,"venue":"Malecón - Guatapé","sala":"Pantalla CORNARE","has_qa":false,"synopsis":"Pablo necesita rescatar a su amiga Pascualina, una gallina ponedora que termina secuestrada por el tendero del pueblo, después de que el niño quebrara la cubeta de huevos que llevaba para pagarle una deuda de su familia.","synopsis_lang":"es","poster":"/assets/guatape-2026/la-gran-hazana.jpg","posterSource":"tmdb","_src":{"url":"https://www.instagram.com/p/Def6fhKDSQy/","date":"2026-10-14","lamina":3},"lbSlug":"the-great-feat","tmdb_id":1494003,"synopsis_en":"A rescue with a spinning tops, feathers, eggs and friends.","title_en":"The Great Feat","id":"f_4895088227","is_free":true,"work_id":"w_R4GWNQW119VA"},{"title":"Basta Mamá","type":"film","section":"🦋 Rumbo a los Macondo","director":"Flora Martínez","year":2026,"duration":"77 min","genre":"Comedia","day":"2026-10-22","time":"18:30","day_order":1,"venue":"Parque Principal - Guatapé","sala":"Domo","has_qa":false,"synopsis":"Fernando, un hombre de 45 años que aún vive con su sobreprotectora madre, intenta ocultarle ese secreto a su moderna novia, quien además es su jefa. Lo que comienza como una pequeña mentira durante una cena de cumpleaños se convierte en un enredo de secretos, choques generacionales y divertidas situaciones que lo obligarán a elegir entre la comodidad de mamá y el amor de su vida.","synopsis_lang":"es","poster":"/assets/guatape-2026/basta-mama.jpg","posterSource":"tmdb","_src":{"url":"https://www.instagram.com/p/Def6fhKDSQy/","date":"2026-10-14","lamina":3},"lbSlug":"basta-mama","tmdb_id":1627217,"synopsis_en":"Fernando's 45th birthday dinner turns into a territorial war when his alpha-mom meets his empowered girlfriend. To survive the night, he must finally cut the umbilical cord or remain her \"little boy\" forever.","id":"f_0e12d37c79","is_free":true,"work_id":"w_8GJ7S9JR04H8"},{"title":"Niños de Las Brisas","type":"film","section":"🌎 FIACINE","director":"Mariane