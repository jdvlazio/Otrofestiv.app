   "que": "enriquecimiento verificado por director"
  },
  {
   "cmd": "python3 pipeline/ensamblar.py cineautopsia-2026",
   "que": "crudo + plan → build"
  },
  {
   "cmd": "python3 pipeline/cineautopsia-2026-stills.py --aplicar",
   "que": "un still 16:9 por obra desde el PDF, solo donde no hay póster mejor"
  },
  {
   "cmd": "python3 pipeline/publicar.py cineautopsia-2026",
   "que": "build → festivals/ (valida el contrato al escribir)"
  }
