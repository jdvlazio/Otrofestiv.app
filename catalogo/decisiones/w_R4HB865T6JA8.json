  "fuente": "https://ficcifestival.com/sites/default/files/2026-05/Catalogo_Oficial_FICCI_65.pdf#page=232"
 },
 {
  "work_id": "w_R4HB865T6JA8",
  "campo": "sinopsis.en",
  "valor": "In a Rio de Janeiro studio in 1975, during Brazil's military dictatorship, a group of friends gathers to read a letter. With elements of theater and performance, this experimental work looks at the Black experience of that period, its demands silenced by both the repressive state and progressive activists.",
  "motivo": "catálogo oficial de FICCI 65, p. 232",
