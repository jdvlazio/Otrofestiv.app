 },
 {
  "work_id": "w_R4HAG84RFFH7",
  "campo": "sinopsis.en",
  "valor": "Through a letter, Lili Massaferro tells her story: the murder of her son Manolo, committed by the police, marked the beginning of a life devoted entirely to political activism. Her voice reflects over photographs of young activists’ wakes: “I understood why he had died, and I was not alone.”",
  "motivo": "catálogo oficial de FICCI 65, p. 267",
